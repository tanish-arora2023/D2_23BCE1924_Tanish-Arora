# ──────────────────────────────────────────────
# NeuroSense ML Service — Environment Variables
# ──────────────────────────────────────────────

# ─── Server ───
ML_SERVICE_PORT=8001
DEBUG=true

# ─── Model ───
MODEL_PATH=./trained_models/dementia_model.pkl
VOSK_MODEL_PATH=./trained_models/vosk_model

# ─── CORS (Node.js backend + frontend origins) ───
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,http://localhost:5173

# ─── Secret key (shared API key for screening endpoints) ───
SECRET_KEY=local-demo-secret-key-123

# ─── Database (SQLite for local dev) ───
DATABASE_URL=sqlite:///./ml_service_local.db
