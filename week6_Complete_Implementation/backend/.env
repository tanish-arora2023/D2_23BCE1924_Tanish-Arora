# ──────────────────────────────────────────────
# NeuroSense Backend — Environment Variables
# ──────────────────────────────────────────────

# ─── Server ───
NODE_ENV=development
PORT=5000

# ─── MongoDB (Docker Compose service name) ───
MONGO_URI=mongodb://mongodb:27017/neurosense_local

# ─── ML Service Proxy ───
ML_PREDICT_URL=http://ml-service:8001/api/screening/predict
ML_SERVICE_API_KEY=local-demo-secret-key-123

# ─── Express Session ───
SESSION_SECRET=local-dev-session-secret-key-456

# ─── Google OAuth 2.0 (dummy — not used in local demo) ───
GOOGLE_CLIENT_ID=dummy_client_id
GOOGLE_CLIENT_SECRET=dummy_client_secret

# ─── GitHub OAuth (dummy — not used in local demo) ───
GITHUB_CLIENT_ID=dummy_client_id
GITHUB_CLIENT_SECRET=dummy_client_secret

# ─── Frontend Origin (for CORS) ───
CLIENT_URL=http://localhost:5173
